DATABASE_URL="postgresql://labrary:labrary@localhost:5432/labrary_digital?schema=public"
API_PORT=3000
WEB_PORT=5173

# Contas locais descritas em README.md. Proibido em produção.
AUTH_DEMO=true
APP_ORIGIN=http://localhost:5173
# Alternativa: caminho absoluto de um diretório JSON com hashes scrypt.
# AUTH_USERS_FILE=/caminho/privado/users.json

# SSO Google: mude AUTH_PROVIDER para google, AUTH_DEMO=false e remova AUTH_USERS_FILE.
# Crie um cliente OAuth do tipo Aplicativo da Web no Google Cloud.
# URI de redirecionamento: http://localhost:5173/api/auth/google/callback
AUTH_PROVIDER=local
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Exceção das oito contas fictícias @labrary.test no Google/PostgreSQL local.
# Usuários reais continuam usando Google. Exige NODE_ENV=development e origem local.
# Depois de habilitar: pnpm contas:teste. Nunca usar em produção.
DEV_TEST_LOGIN=false
# NODE_ENV=development

# No modo Google, todo o domínio acadêmico e o controle R2 ficam no PostgreSQL.
# Execute pnpm db:deploy; para uma instalação antiga, pnpm db:importar-json.
# Os caminhos de arquivos ao final são usados só no demo isolado/importação.

# Pasta privada dos materiais enviados (relativa à raiz do repositório ou absoluta).
# Nunca deve ser servida como arquivo estático.
UPLOAD_DIR=.uploads

# Materiais no Cloudflare R2 privado, opcional. Padrão: disco local.
# A franquia gratuita não é um bloqueio de cobrança da Cloudflare.
# Guia e limites: docs/arquitetura.md, seção Armazenamento de arquivos.
STORAGE_PROVIDER=disk
# R2_ACCOUNT_ID=
# R2_BUCKET=labrary-materiais
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Somente importação legada/demo; no modo Google o controle usa r2_usage.
# R2_USAGE_FILE=/caminho/privado/r2-usage.json

# Somente demo isolado ou importação da persistência legada; ignorados pelo
# domínio acadêmico do modo Google em execução normal.
# PROJECT_DATA_FILE=/caminho/privado/projects.json
# GROUP_DATA_FILE=/caminho/privado/groups.json
# RUBRIC_DATA_FILE=/caminho/privado/rubrics.json
# EVALUATION_DATA_FILE=/caminho/privado/evaluations.json
# RESULT_RELEASE_DATA_FILE=/caminho/privado/results.json
