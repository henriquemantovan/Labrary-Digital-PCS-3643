DATABASE_URL="postgresql://labrary:labrary@localhost:5432/labrary_digital?schema=public"
API_PORT=3000
WEB_PORT=5173

# Contas locais descritas em docs/hu01.md. Proibido em produção.
AUTH_DEMO=true
APP_ORIGIN=http://localhost:5173
# Alternativa: caminho absoluto de um diretório JSON com hashes scrypt.
# AUTH_USERS_FILE=/caminho/privado/users.json

# SSO Google: mude AUTH_PROVIDER para google, AUTH_DEMO=false e remova AUTH_USERS_FILE.
# Crie um cliente OAuth do tipo Aplicativo da Web no Google Cloud.
# URI de redirecionamento: http://localhost:5173/api/auth/google/callback
AUTH_PROVIDER=local
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# HU07: snapshot privado de projetos, metadados e mensagens (um processo escritor).
# Padrão: .data/projects-demo.json, projects-local.json ou projects-google.json.
# Para conservar os dados fora do checkout, use um caminho absoluto em disco persistente.
# PROJECT_DATA_FILE=/caminho/privado/projects.json

# Pasta privada dos materiais enviados (relativa à raiz do repositório ou absoluta).
# Nunca deve ser servida como arquivo estático.
UPLOAD_DIR=.uploads
