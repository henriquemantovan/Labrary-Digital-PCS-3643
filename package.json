{
  "name": "labrary-digital",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"pnpm --filter @labrary/api dev\" \"pnpm --filter @labrary/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @labrary/api db:generate",
    "test:e2e": "playwright test",
    "auth:hash": "pnpm --silent --filter @labrary/api exec tsx src/scripts/hashPassword.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "10.0.6"
  }
}
