{
  "name": "labrary-digital",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "storage:init": "pnpm --filter @labrary/api storage:init",
    "demo": "bash scripts/demo.sh",
    "dev": "concurrently --names api,web --prefix-colors blue,green \"pnpm --filter @labrary/api dev\" \"pnpm --filter @labrary/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @labrary/api db:generate",
    "test:e2e": "playwright test && playwright test --config playwright.submission.config.ts && playwright test --config playwright.grades.config.ts --project desktop && playwright test --config playwright.grades.config.ts --project mobile && playwright test --config playwright.evaluation.config.ts && playwright test --config playwright.publication.config.ts && playwright test --config playwright.academic.config.ts && playwright test --config playwright.test-accounts.config.ts",
    "auth:hash": "pnpm --silent --filter @labrary/api exec tsx src/scripts/hashPassword.ts",
    "contas:teste": "pnpm --filter @labrary/api contas:teste",
    "db:deploy": "pnpm --filter @labrary/api db:deploy",
    "db:importar-json": "pnpm --filter @labrary/api db:importar-json",
    "db:baseline": "pnpm --filter @labrary/api db:baseline",
    "db:status": "pnpm --filter @labrary/api db:status",
    "db:test": "pnpm --filter @labrary/api db:test",
    "demo:publicacao": "RECORD_PUBLICATION_DEMO=1 playwright test --config playwright.publication.config.ts --project desktop",
    "demonstracao:completa": "pnpm --filter @labrary/api demonstracao:completa"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "10.0.6"
  }
}
