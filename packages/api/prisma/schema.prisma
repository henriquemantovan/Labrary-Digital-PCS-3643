generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ALUNO
  AVALIADOR
  PROFESSOR

  @@map("user_role")
}

enum ProjectStatus {
  PREPARACAO
  EM_AVALIACAO
  AJUSTES
  FINALIZADO

  @@map("project_status")
}

enum MaterialKind {
  VIDEO
  RELATORIO
  MANUAL
  OUTRO

  @@map("material_kind")
}

enum SubmissionStatus {
  EM_AVALIACAO
  DEVOLVIDA
  CONCLUIDA

  @@map("submission_status")
}

model AppUser {
  id           BigInt   @id @default(autoincrement())
  fullName     String   @map("full_name") @db.VarChar(160)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  classes       CourseClass[]     @relation("ClassProfessor")
  memberships   GroupMembership[]
  authoredFiles MaterialVersion[] @relation("FileUploader")
  messages      ProjectMessage[]

  @@map("app_user")
}

model CourseClass {
  id           BigInt @id @default(autoincrement())
  name         String @db.VarChar(120)
  academicYear Int    @map("academic_year") @db.SmallInt
  professorId  BigInt @map("professor_id")

  professor AppUser        @relation("ClassProfessor", fields: [professorId], references: [id])
  groups    StudentGroup[]
  projects  Project[]

  @@unique([name, academicYear])
  @@map("course_class")
}

model StudentGroup {
  id      BigInt @id @default(autoincrement())
  classId BigInt @map("class_id")
  name    String @db.VarChar(120)

  courseClass CourseClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  members     GroupMembership[]
  project     Project?

  @@unique([id, classId])
  @@unique([classId, name])
  @@map("student_group")
}

model GroupMembership {
  id       BigInt    @id @default(autoincrement())
  groupId  BigInt    @map("group_id")
  userId   BigInt    @map("user_id")
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt   DateTime? @map("left_at") @db.Timestamptz

  group StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  AppUser      @relation(fields: [userId], references: [id])

  @@index([groupId])
  @@map("group_membership")
}

model Project {
  id          BigInt        @id @default(autoincrement())
  classId     BigInt        @map("class_id")
  groupId     BigInt        @unique @map("group_id")
  title       String        @db.VarChar(200)
  description String        @default("")
  category    String        @db.VarChar(100)
  status      ProjectStatus @default(PREPARACAO)
  dueAt       DateTime?     @map("due_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  courseClass  CourseClass       @relation(fields: [classId], references: [id])
  group        StudentGroup      @relation(fields: [groupId, classId], references: [id, classId])
  materials    ProjectMaterial[]
  messages     ProjectMessage[]
  submissions  Submission[]
  evaluators   ProjectEvaluator[]

  @@unique([id, groupId])
  @@unique([groupId, classId])
  @@index([classId, status])
  @@map("project")
}

model ProjectEvaluator {
  projectId   BigInt   @map("project_id")
  evaluatorId BigInt   @map("evaluator_id")
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, evaluatorId])
  @@map("project_evaluator")
}

model ProjectMaterial {
  id        BigInt      @id @default(autoincrement())
  projectId BigInt      @map("project_id")
  kind      MaterialKind
  title     String      @db.VarChar(200)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  project  Project          @relation(fields: [projectId], references: [id])
  versions MaterialVersion[]

  @@unique([id, projectId])
  @@map("project_material")
}

model MaterialVersion {
  id               BigInt   @id @default(autoincrement())
  materialId       BigInt   @map("material_id")
  versionNumber    Int      @map("version_number")
  storageKey       String   @unique @map("storage_key")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type") @db.VarChar(160)
  sizeBytes        BigInt   @map("size_bytes")
  uploadedBy       BigInt   @map("uploaded_by")
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  material  ProjectMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  uploader  AppUser         @relation("FileUploader", fields: [uploadedBy], references: [id])
  messages  ProjectMessage[]

  @@unique([materialId, versionNumber])
  @@unique([id, materialId])
  @@map("material_version")
}

model Submission {
  id           BigInt           @id @default(autoincrement())
  projectId    BigInt           @map("project_id")
  roundNumber  Int              @map("round_number")
  status       SubmissionStatus @default(EM_AVALIACAO)
  submittedAt  DateTime         @default(now()) @map("submitted_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, roundNumber])
  @@unique([id, projectId])
  @@map("submission")
}

model ProjectMessage {
  id                BigInt   @id @default(autoincrement())
  projectId         BigInt   @map("project_id")
  authorId          BigInt   @map("author_id")
  materialVersionId BigInt?  @map("material_version_id")
  body              String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author         AppUser         @relation(fields: [authorId], references: [id])
  materialVersion MaterialVersion? @relation(fields: [materialVersionId], references: [id])

  @@index([projectId, createdAt])
  @@map("project_message")
}
